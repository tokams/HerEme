{
  "name": "hereme-local-forum",
  "version": "0.1.0",
  "private": true,
  "description": "HerEme: local-first forum proof of concept",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed:demo": "node scripts/seed-demo.js",
    "staff:provision": "node scripts/provision-staff.js",
    "content:import-users": "node scripts/import-user-content.js",
    "push:generate-vapid": "node scripts/generate-vapid.js",
    "push:worker": "node server/push-worker.js",
    "content:git-worker": "node server/content-git-worker.js",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:chat-browser": "node tests/chat-browser.cjs",
    "test:pwa-browser": "node tests/pwa-browser.cjs",
    "test:passkeys-browser": "node tests/passkeys-browser.cjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-source.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.23.0"
  }
}
