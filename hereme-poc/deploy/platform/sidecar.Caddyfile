{
	admin off
	auto_https off
}

http://{$INSTANCE_HOST}:8080 {
	@edge remote_ip {$EDGE_PEER}
	handle @edge {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {http.request.header.X-Hereme-Client}
			header_up X-Forwarded-Proto https
			header_up -X-Hereme-Client
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	respond 403
}
