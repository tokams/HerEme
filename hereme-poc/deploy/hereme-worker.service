[Unit]
Description=HerEme media worker
After=hereme.service

[Service]
Type=simple
User=hereme
Group=hereme
WorkingDirectory=/opt/hereme/current
EnvironmentFile=/etc/hereme/hereme.env
ExecStart=/usr/bin/node server/media-worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hereme /var/log/hereme
UMask=0027

[Install]
WantedBy=multi-user.target
