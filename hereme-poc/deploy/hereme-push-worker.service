[Unit]
Description=HerEme Web Push delivery worker
After=network-online.target hereme.service
Requires=hereme.service

[Service]
Type=simple
User=hereme
Group=hereme
EnvironmentFile=/etc/hereme/hereme.env
EnvironmentFile=/etc/hereme/hereme-push.env
Environment=HEREME_PUSH_WORKER=1
WorkingDirectory=/opt/hereme/current
ExecStart=/usr/bin/node server/push-worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hereme

[Install]
WantedBy=multi-user.target
