HEREME_ENV=production
HEREME_DATA_DIR=/var/lib/hereme
HOST=127.0.0.1
PORT=3000
HEREME_PUBLIC_ORIGIN=https://example.invalid
HEREME_TRUST_PROXY=loopback
HEREME_MIN_FREE_BYTES=2147483648
HEREME_SESSION_DAYS=30
HEREME_LOG_FORMAT=json
HEREME_ENABLE_VIDEO=0
HEREME_MAX_VIDEO_BYTES=2147483648
HEREME_FFPROBE=/usr/bin/ffprobe
HEREME_FFMPEG=/usr/bin/ffmpeg
HEREME_ENABLE_LOCATIONS=0
HEREME_ENABLE_VERIFICATION=0
HEREME_BACKUP_DIR=/var/backups/hereme
HEREME_BACKUP_KEEP=14
